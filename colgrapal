import numpy as np
def colorear_grafo_algebraico(G, k):
    """Parámetros:
    - G: Un objeto de tipo Graph de SageMath (o un diccionario de adyacencia).
    - k: Número de colores (.
    """
    # Obtener número de vértices y mapear nombres a índices 0...n-1
    vertices = list(G.vertices())
    n = len(vertices)
    v_to_idx = {v: i for i, v in enumerate(vertices)}
    
    #Inicializar el anillo de pol, el cuerpo es Q
    #Usanado orden lexicográfico ('lex') 
    var_names = [f'x{i}' for i in range(n)]
    R = PolynomialRing(QQ, names=var_names, order='lex')
    variables = R.gens()
    
    polinomios_ideal = []
    #Restricción de Vértices: x_i^k - 1 = 0
    for i in range(n):
        polinomios_ideal.append(variables[i]^k - 1)
        
    #reestricción de aristas
    #Si k=2: x_i + x_j = 0
    #Si k=3: x_i^2 + x_i*x_j + x_j^2 = 0
    for u, v in G.edges(labels=False):
        i = v_to_idx[u]
        j = v_to_idx[v]
        xi = variables[i]
        xj = variables[j]
        
        #Construccion del polinomio divisor
    #ideal
    I = R.ideal(polinomios_ideal)
    
    #base de grobner
    G_basis = I.groebner_basis()
    
    # Criterio de Consistencia. Si la base reducida contiene únicamente al 1, el sistema es inconsistente.
    if G_basis == [R(1)]:
        print("El grafo NO es colorable.")
        print("Certificado algebraico (Base de Gröbner Reducida) = [1]")
