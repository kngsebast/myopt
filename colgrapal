    print(f"Se encontraron {len(soluciones)} coloraciones válidas en la variedad afín.\n")
    
    #Mostrar los coloreos obtenidos
    for idx, sol in enumerate(soluciones[:2]):
        print(f"Coloración #{idx + 1}:")
        for i in range(n):
            nodo_original = vertices[i]
            val_complejo = complex(sol[variables[i]])
            
            angulo = np.angle(val_complejo)
            if angulo < 0:
                angulo += 2 * np.pi # Normalizar a [0, 2*pi)
                
            m = int(round(angulo / (2 * np.pi / k))) % k
            
            if m == 0:
                omega_str = "1"
            elif m == 1:
                omega_str = f"ω_1"
            else:
                omega_str = f"ω_{m}"
                
            print(f"  Vértice {nodo_original} ---> Color geométrico: {omega_str}")
    return soluciones
def graficar_coloreo_algebraico(G, soluciones, k):    
    if not soluciones:
        print("No hay soluciones que graficar.")
        return
        
    primera_sol = soluciones[0]
    
    vertices = list(G.vertices())
    n = len(vertices)
    paleta_colores = ['#ff4d4d', '#4da6ff', '#5cd65c', '#ffb366', '#cc66ff', '#ffff66']
    #                  Rojo       Azul       Verde      Naranja    Morado     Amarillo
    
    color_map = {}
    
    vertices_por_color = {color: [] for color in paleta_colores[:k]}

    for i, v in enumerate(vertices):
        #Encontrar la variable correspondiente en el anillo de la solución
        #Buscamr la variable que coincida con el nombre x_i
        var_anillo = [var for var in primera_sol.keys() if str(var) == f'x{i}'][0]
        val_complejo = complex(primera_sol[var_anillo])
        
        #Calcular el exponente m de la raíz de la unidad (mismo algoritmo anterior)
        angulo = np.angle(val_complejo)
        if angulo < 0: angulo += 2 * np.pi
        m = int(round(angulo / (2 * np.pi / k))) % k
        
        #Asignar el color de la paleta según el índice m
        color_asignado = paleta_colores[m]
        vertices_por_color[color_asignado].append(v)

    G.show(vertex_colors=vertices_por_color, 
           vertex_size=500, 
           edge_thickness=2, 
           title=f"Grafo Coloreado Eficientemente (k={k})")
    
